{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/contracts/**/*.ts",
    "src/core/**/*.ts",
    "src/orchestrator/**/*.ts",
    "src/scheduler/**/*.ts",
    "src/agents/**/*.ts",
    "src/api/**/*.ts",
    "src/db/**/*.ts",
    "backend/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "app/**",
    "src/config/**",
    "src/client/**",
    "hooks/**",
    "node_modules/**"
  ]
}
