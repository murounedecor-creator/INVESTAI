{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "backend/**",
    "src/api/**",
    "src/core/**",
    "src/orchestrator/**",
    "src/scheduler/**",
    "src/agents/**",
    "src/db/**",
    "test/**"
  ]
}
